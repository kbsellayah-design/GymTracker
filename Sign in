<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Plates & Progress</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
  :root{--bg:#F3F2EE;--card:#FFFFFF;--card-border:#E4E2DC;--text:#1A1B1E;--muted:#6B6D72;--accent:#C8353D;--accent-text:#FFFFFF;--accent-2:#3D5A80;--track:#E4E2DC;--success:#3F7D5C;--font-head:'Oswald',sans-serif;--font-body:'Inter',sans-serif;}
  @media (prefers-color-scheme: dark){:root:not([data-theme="light"]){--bg:#17181A;--card:#212327;--card-border:#33353A;--text:#ECEBE6;--muted:#8B8D93;--accent:#E15252;--accent-text:#17181A;--accent-2:#6690C4;--track:#33353A;--success:#6FBE93;}}
  *{box-sizing:border-box;}
  body{margin:0;background:var(--bg);color:var(--text);font-family:var(--font-body);min-height:100vh;padding-bottom:84px;}
  .wrap{max-width:480px;margin:0 auto;padding:20px 18px 8px;}
  .brand{font-family:var(--font-head);font-weight:700;font-size:22px;}
  .brand span{color:var(--accent);}
  .card{background:var(--card);border:1px solid var(--card-border);border-radius:14px;padding:16px;margin-bottom:14px;}
  .btn{display:flex;align-items:center;justify-content:center;gap:6px;font-weight:600;font-size:14.5px;border:none;border-radius:10px;padding:13px 16px;cursor:pointer;width:100%;}
  .btn-primary{background:var(--accent);color:var(--accent-text);}
  .btn-ghost{background:transparent;color:var(--text);border:1px solid var(--card-border);}
  input{font-family:var(--font-body);background:var(--bg);border:1px solid var(--card-border);color:var(--text);border-radius:9px;padding:11px 12px;font-size:14.5px;width:100%;margin-bottom:10px;}
  .pro-banner{background:linear-gradient(135deg,var(--accent),var(--accent-2));color:#fff;border-radius:14px;padding:14px 16px;margin-bottom:14px;}
  .pro-banner .btn{background:#fff;color:var(--text);margin-top:10px;}
  .hidden{display:none;}
  .msg{font-size:13px;color:var(--muted);margin-top:6px;}
  .lock{opacity:0.4;pointer-events:none;filter:blur(2px);}
</style>
</head>
<body>
<div class="wrap">

  <!-- AUTH SCREEN -->
  <div id="authScreen">
    <div class="brand" style="margin-bottom:20px;">Plates & <span>Progress</span></div>
    <div class="card">
      <input type="email" id="authEmail" placeholder="Email">
      <input type="password" id="authPassword" placeholder="Password">
      <button class="btn btn-primary" id="signInBtn">Sign in</button>
      <button class="btn btn-ghost" id="signUpBtn" style="margin-top:8px;">Create account</button>
      <div class="msg" id="authMsg"></div>
    </div>
  </div>

  <!-- APP SCREEN -->
  <div id="appScreen" class="hidden">
    <div class="brand" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
      <div>Plates & <span>Progress</span></div>
      <button class="btn-ghost" id="signOutBtn" style="width:auto;padding:6px 10px;border-radius:8px;font-size:12px;">Sign out</button>
    </div>

    <div id="proBanner" class="pro-banner hidden">
      Free plan: last 5 sessions of progress history.
      <button class="btn" id="upgradeBtn">Upgrade to Pro — $4.99/mo</button>
    </div>

    <div class="card">
      <div style="font-weight:600;margin-bottom:10px;">Log today's session</div>
      <input type="date" id="logDate">
      <input type="text" id="exerciseName" placeholder="Exercise (e.g. Bench Press)">
      <input type="number" id="setWeight" placeholder="Weight (lb)">
      <input type="number" id="setReps" placeholder="Reps">
      <button class="btn btn-primary" id="saveSetBtn">Save set</button>
      <div class="msg" id="saveMsg"></div>
    </div>

    <div class="card">
      <div style="font-weight:600;margin-bottom:10px;">Recent sessions</div>
      <div id="sessionsList" class="msg">Loading&hellip;</div>
    </div>
  </div>

</div>

<script>
// ====== 1. FILL THESE IN from your Supabase project settings ======
const SUPABASE_URL = 'https://YOUR-PROJECT.supabase.co';
const SUPABASE_ANON_KEY = 'YOUR-ANON-PUBLIC-KEY';
// Stripe Payment Link (create in Stripe Dashboard > Payment Links)
const STRIPE_PAYMENT_LINK = 'https://buy.stripe.com/your-link-here';
// ====================================================================

const supabase = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
let currentUser = null;
let isPro = false;

const authScreen = document.getElementById('authScreen');
const appScreen = document.getElementById('appScreen');
const authMsg = document.getElementById('authMsg');

document.getElementById('logDate').value = new Date().toISOString().slice(0,10);

async function refreshSession(){
  const { data: { session } } = await supabase.auth.getSession();
  if (session){
    currentUser = session.user;
    authScreen.classList.add('hidden');
    appScreen.classList.remove('hidden');
    await loadProfile();
    await loadSessions();
  } else {
    currentUser = null;
    authScreen.classList.remove('hidden');
    appScreen.classList.add('hidden');
  }
}

document.getElementById('signUpBtn').addEventListener('click', async () => {
  const email = document.getElementById('authEmail').value;
  const password = document.getElementById('authPassword').value;
  const { error } = await supabase.auth.signUp({ email, password });
  authMsg.textContent = error ? error.message : 'Check your email to confirm, then sign in.';
});

document.getElementById('signInBtn').addEventListener('click', async () => {
  const email = document.getElementById('authEmail').value;
  const password = document.getElementById('authPassword').value;
  const { error } = await supabase.auth.signInWithPassword({ email, password });
  if (error){ authMsg.textContent = error.message; return; }
  refreshSession();
});

document.getElementById('signOutBtn').addEventListener('click', async () => {
  await supabase.auth.signOut();
  refreshSession();
});

async function loadProfile(){
  const { data } = await supabase.from('profiles').select('is_pro').eq('id', currentUser.id).single();
  isPro = data ? data.is_pro : false;
  const banner = document.getElementById('proBanner');
  banner.classList.toggle('hidden', isPro);
}

document.getElementById('upgradeBtn').addEventListener('click', () => {
  // client_reference_id ties the Stripe payment back to this user for the webhook
  window.location.href = STRIPE_PAYMENT_LINK + '?client_reference_id=' + currentUser.id;
});

document.getElementById('saveSetBtn').addEventListener('click', async () => {
  const date = document.getElementById('logDate').value;
  const name = document.getElementById('exerciseName').value.trim();
  const weight = document.getElementById('setWeight').value;
  const reps = document.getElementById('setReps').value;
  const saveMsg = document.getElementById('saveMsg');
  if (!name || !weight || !reps){ saveMsg.textContent = 'Fill in exercise, weight, and reps.'; return; }

  const { data: existing } = await supabase.from('workouts').select('*')
    .eq('user_id', currentUser.id).eq('date', date).maybeSingle();

  if (existing){
    const exercises = existing.exercises;
    let ex = exercises.find(e => e.name === name);
    if (!ex){ ex = { name, sets: [] }; exercises.push(ex); }
    ex.sets.push({ weight, reps });
    await supabase.from('workouts').update({ exercises }).eq('id', existing.id);
  } else {
    await supabase.from('workouts').insert({
      user_id: currentUser.id, date,
      exercises: [{ name, sets: [{ weight, reps }] }]
    });
  }
  saveMsg.textContent = 'Saved.';
  document.getElementById('exerciseName').value = '';
  document.getElementById('setWeight').value = '';
  document.getElementById('setReps').value = '';
  loadSessions();
});

async function loadSessions(){
  const limit = isPro ? 100 : 5;
  const { data, error } = await supabase.from('workouts')
    .select('*').eq('user_id', currentUser.id)
    .order('date', { ascending: false }).limit(limit);

  const list = document.getElementById('sessionsList');
  if (error){ list.textContent = error.message; return; }
  if (!data || data.length === 0){ list.textContent = 'No sessions yet.'; return; }

  list.innerHTML = data.map(w => {
    const names = w.exercises.map(e => e.name).join(', ');
    return `<div style="padding:8px 0;border-bottom:1px solid var(--card-border);">
      <div style="font-weight:600;font-size:14px;">${w.date}</div>
      <div style="font-size:12.5px;color:var(--muted);">${names}</div>
    </div>`;
  }).join('');
}

refreshSession();
</script>
</body>
</html>
